#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Lista de verbos preferidos no início (estilo humano, primeira pessoa no passado)
allowed_prefixes=(
  "Adicionei" "Atualizei" "Renomeei" "Removi" "Organizei" "Incluí" "Separei" "Deixei"
  "Criei" "Melhorei" "Corrigi" "Desfiz" "Voltei" "Expliquei"
)

is_allowed=false
for p in "${allowed_prefixes[@]}"; do
  if [[ "$first_line" == "$p"* ]]; then
    is_allowed=true
    break
  fi
done

# Alerta leve (não bloqueia): caso não esteja no padrão ou use "Revert \"...\""
if [[ "$is_allowed" == false || "$first_line" =~ ^Revert\  ]]; then
  echo "[commit-msg] Sugestão de estilo mais humano: primeira pessoa no passado, frases curtas." >&2
  echo "[commit-msg] Exemplos: 'Atualizei ...', 'Renomeei ...', 'Desfiz ...'" >&2
  echo "[commit-msg] Mensagem atual: $first_line" >&2
fi

exit 0