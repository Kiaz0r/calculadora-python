# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (do not version)
venv/
.venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/

# Type checking / static analysis
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# IDE / Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific
.DS_Store
Thumbs.db

# Environment files
.env
.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp
~$*

# Optional: ignore SQLite databases or local data caches
*.sqlite3
*.db

# Optional: ignore local coverage reports and reports folders
reports/

# Optional: ignore local tooling caches
.cache/